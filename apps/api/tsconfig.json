{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "paths": {
      "@orison/auth": ["../../packages/auth/src/index.ts"],
      "@orison/config": ["../../packages/config/src/index.ts"],
      "@orison/logger": ["../../packages/logger/src/index.ts"],
      "@orison/types": ["../../packages/types/src/index.ts"],
      "@orison/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
